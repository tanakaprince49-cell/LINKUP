{
  "cli": {
    "version": ">= 18.12.3",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "environment": "development",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_DIRECT_AI": "true",
        "EXPO_PUBLIC_OPENROUTER_MODEL": "deepseek/deepseek-chat"
      }
    },
    "preview": {
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_DIRECT_AI": "true",
        "EXPO_PUBLIC_OPENROUTER_MODEL": "deepseek/deepseek-chat"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_ENABLE_DIRECT_AI": "true",
        "EXPO_PUBLIC_OPENROUTER_MODEL": "deepseek/deepseek-chat"
      }
    },
    "apk": {
      "environment": "preview",
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENABLE_DIRECT_AI": "true",
        "EXPO_PUBLIC_OPENROUTER_MODEL": "deepseek/deepseek-chat"
      },
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
