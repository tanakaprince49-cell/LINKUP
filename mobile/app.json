{
  "expo": {
    "name": "LINKUP",
    "slug": "linkup",
    "scheme": "linkup",
    "version": "12.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-padded.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-padded.png",
      "resizeMode": "contain",
      "backgroundColor": "#FBE618"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.tana.linkup",
      "versionCode": 12,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-padded.png",
        "backgroundColor": "#FBE618"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "favicon": "./assets/logo-square.png"
    },
    "extra": {
      "eas": {
        "projectId": "62db6e6e-e4be-44ff-a0c1-9437f43ba980"
      }
    },
    "plugins": [
      "./plugins/withAdiRegistration",
      [
        "expo-notifications",
        {
          "color": "#FBE618",
          "defaultChannel": "default"
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow LINKUP to send photos and videos in chat.",
          "cameraPermission": "Allow LINKUP to take photos and videos for chat.",
          "microphonePermission": "Allow LINKUP to record audio when sending chat videos."
        }
      ],
      "expo-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ]
    ],
    "owner": "talala"
  }
}
