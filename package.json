{
  "name": "linkup-expo-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix mobile run web",
    "build": "npm --prefix mobile ci && npm --prefix mobile run build:web",
    "preview": "npx serve mobile/dist",
    "lint": "npm --prefix mobile run typecheck",
    "test:web-paths": "npm --prefix mobile run test:web-paths",
    "test:seo": "node --test tests/public-seo.test.mjs",
    "test:payments": "node --test tests/web-returns.test.mjs tests/payonify-signature.test.mjs",
    "verify:web-routing": "node scripts/verify-web-routing.mjs",
    "test:copy": "node --test tests/professional-copy.test.mjs",
    "test:linky": "node --test tests/linky-usage.test.mjs tests/app-review.test.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "firebase-admin": "^13.10.0"
  },
  "description": "LINKUP is an Expo React Native app for mobile and web. Production web deploys serve the Expo app from mobile/ via Vercel; the api/ directory holds the Vercel serverless functions (they import firebase-admin, which is the only root dependency).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanakaprince49-cell/LINKUP.git"
  },
  "license": "ISC"
}
