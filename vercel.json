{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "git": {
    "deploymentEnabled": {
      "codex/**": false
    }
  },
  "installCommand": "npm ci --no-audit --no-fund && cd mobile && npm ci",
  "buildCommand": "cd mobile && npm run build:web",
  "outputDirectory": "mobile/dist",
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/app/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/app/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    },
    {
      "source": "/privacy(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/app/builder-league",
      "destination": "/api/publicSeo?mode=league"
    },
    {
      "source": "/app/builder-league/card",
      "destination": "/api/publicSeo?mode=league-card"
    },
    {
      "source": "/app/builder-league/month",
      "destination": "/api/publicSeo?mode=league&period=month"
    },
    {
      "source": "/app/builder-league/year",
      "destination": "/api/publicSeo?mode=league&period=year"
    },
    {
      "source": "/app/builder-league/all",
      "destination": "/api/publicSeo?mode=league&period=all"
    },
    {
      "source": "/app/momentum",
      "destination": "/api/publicSeo?mode=momentum"
    },
    {
      "source": "/app/momentum/:uid/card",
      "destination": "/api/publicSeo?mode=momentum-card&uid=:uid"
    },
    {
      "source": "/momentum/:uid/card",
      "destination": "/api/publicSeo?mode=momentum-card&uid=:uid"
    },
    {
      "source": "/app/momentum/:uid",
      "destination": "/api/publicSeo?mode=momentum-profile&uid=:uid"
    },
    {
      "source": "/app/sitemap-momentum.xml",
      "destination": "/api/publicSeo?mode=momentum-sitemap"
    },
    {
      "source": "/builder-league",
      "destination": "/api/publicSeo?mode=league"
    },
    {
      "source": "/builder-league/card",
      "destination": "/api/publicSeo?mode=league-card"
    },
    {
      "source": "/builder-league/month",
      "destination": "/api/publicSeo?mode=league&period=month"
    },
    {
      "source": "/builder-league/year",
      "destination": "/api/publicSeo?mode=league&period=year"
    },
    {
      "source": "/builder-league/all",
      "destination": "/api/publicSeo?mode=league&period=all"
    },
    {
      "source": "/momentum",
      "destination": "/api/publicSeo?mode=momentum"
    },
    {
      "source": "/momentum/:uid",
      "destination": "/api/publicSeo?mode=momentum-profile&uid=:uid"
    },
    {
      "source": "/sitemap-momentum.xml",
      "destination": "/api/publicSeo?mode=momentum-sitemap"
    },
    {
      "source": "/app/campaigns",
      "destination": "/api/publicSeo?mode=campaigns"
    },
    {
      "source": "/app/campaigns/:id",
      "destination": "/api/publicSeo?mode=campaign&id=:id"
    },
    {
      "source": "/app/startups",
      "destination": "/api/publicSeo?mode=startups"
    },
    {
      "source": "/app/startups/:id",
      "destination": "/api/publicSeo?mode=startup&id=:id"
    },
    {
      "source": "/app/news",
      "destination": "/api/publicSeo?mode=news"
    },
    {
      "source": "/app/sitemap-campaigns-:page.xml",
      "destination": "/api/publicSeo?mode=campaign-sitemap&page=:page"
    },
    {
      "source": "/app/sitemap-startups-:page.xml",
      "destination": "/api/publicSeo?mode=startup-sitemap&page=:page"
    },
    {
      "source": "/campaigns",
      "destination": "/api/publicSeo?mode=campaigns"
    },
    {
      "source": "/campaigns/:id",
      "destination": "/api/publicSeo?mode=campaign&id=:id"
    },
    {
      "source": "/startups",
      "destination": "/api/publicSeo?mode=startups"
    },
    {
      "source": "/startups/:id",
      "destination": "/api/publicSeo?mode=startup&id=:id"
    },
    {
      "source": "/news",
      "destination": "/api/publicSeo?mode=news"
    },
    {
      "source": "/sitemap-campaigns-:page.xml",
      "destination": "/api/publicSeo?mode=campaign-sitemap&page=:page"
    },
    {
      "source": "/sitemap-startups-:page.xml",
      "destination": "/api/publicSeo?mode=startup-sitemap&page=:page"
    },
    {
      "source": "/privacy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/privacy/",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/privacy-policy/",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/app/privacy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/app/privacy/",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/app/privacy-policy/",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/app/privacy.html",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/app/privacy-policy.html",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/app/p/:uid",
      "destination": "/api/publicSeo?mode=profile&uid=:uid"
    },
    {
      "source": "/app/builders",
      "destination": "/api/publicSeo?mode=directory"
    },
    {
      "source": "/app/sitemap.xml",
      "destination": "/api/publicSeo?mode=sitemap"
    },
    {
      "source": "/app/sitemap-static.xml",
      "destination": "/api/publicSeo?mode=static"
    },
    {
      "source": "/app/sitemap-profiles-:page.xml",
      "destination": "/api/publicSeo?mode=profiles&page=:page"
    },
    {
      "source": "/app/robots.txt",
      "destination": "/api/publicSeo?mode=robots"
    },
    {
      "source": "/p/:uid",
      "destination": "/api/publicSeo?mode=profile&uid=:uid"
    },
    {
      "source": "/builders",
      "destination": "/api/publicSeo?mode=directory"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/publicSeo?mode=sitemap"
    },
    {
      "source": "/sitemap-static.xml",
      "destination": "/api/publicSeo?mode=static"
    },
    {
      "source": "/sitemap-profiles-:page.xml",
      "destination": "/api/publicSeo?mode=profiles&page=:page"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/publicSeo?mode=robots"
    },
    {
      "source": "/app/_expo/:path*",
      "destination": "/_expo/:path*"
    },
    {
      "source": "/app/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/app/icons/:path*",
      "destination": "/icons/:path*"
    },
    {
      "source": "/app/favicon.ico",
      "destination": "/favicon.ico"
    },
    {
      "source": "/app/manifest.webmanifest",
      "destination": "/manifest.webmanifest"
    },
    {
      "source": "/app/service-worker.js",
      "destination": "/service-worker.js"
    },
    {
      "source": "/app/landing",
      "destination": "/landing.html"
    },
    {
      "source": "/landing",
      "destination": "/landing.html"
    },
    {
      "source": "/app/index.html",
      "destination": "/index.html"
    },
    {
      "source": "/app/__/auth/:path*",
      "destination": "https://linkup-e0906.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/app/__/firebase/:path*",
      "destination": "https://linkup-e0906.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/app/data-deletion",
      "destination": "/data-deletion.html"
    },
    {
      "source": "/app/account-deletion",
      "destination": "/data-deletion.html"
    },
    {
      "source": "/app/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/app/child-safety-standards",
      "destination": "/child-safety-standards.html"
    },
    {
      "source": "/app/api/telegram",
      "destination": "/api/linky?channel=telegram"
    },
    {
      "source": "/app/api/whatsapp",
      "destination": "/api/linky?channel=whatsapp"
    },
    {
      "source": "/app/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/__/auth/:path*",
      "destination": "https://linkup-e0906.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/:path*",
      "destination": "https://linkup-e0906.firebaseapp.com/__/firebase/:path*"
    },
    {
      "source": "/data-deletion",
      "destination": "/data-deletion.html"
    },
    {
      "source": "/account-deletion",
      "destination": "/data-deletion.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/child-safety-standards",
      "destination": "/child-safety-standards.html"
    },
    {
      "source": "/api/telegram",
      "destination": "/api/linky?channel=telegram"
    },
    {
      "source": "/api/whatsapp",
      "destination": "/api/linky?channel=whatsapp"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/linky.js": {
      "maxDuration": 60
    },
    "api/publicSeo.js": {
      "includeFiles": "api/_assets/**",
      "maxDuration": 60
    }
  }
}
