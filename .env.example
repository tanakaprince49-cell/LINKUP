# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Payonify (Zimbabwe) — LINKUP web checkout for prepaid PLUS / Campaigns terms.
# Server-side ONLY (Vercel env vars). The Secret Key must NEVER
# reach the app bundle or the git repo. See PAYONIFY_SETUP.md.
#
# Get your keys from https://payonify.co.zw → Developer Settings → API Keys.
# Start on sandbox (pk_test_ / sk_test_); switch PAYONIFY_ENV to "live" only
# once the live credentials (pk_live_ / sk_live_) are in place.
PAYONIFY_PUBLISHABLE_KEY="pk_test_YOUR_KEY_HERE"
PAYONIFY_SECRET_KEY="sk_test_YOUR_KEY_HERE"

# Webhook secret for signature verification. Get this from Payonify dashboard
# → Developer Settings → Webhooks. Long, random, secret.
PAYONIFY_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET"

# Where Payonify sends the browser afterwards. Entitlement is granted by the
# webhook, never by the browser landing on successUrl.
PAYONIFY_SUCCESS_URL="https://linkup-muqu.vercel.app/paynow/return"
PAYONIFY_CANCEL_URL="https://linkup-muqu.vercel.app/paynow/cancel"

# "sandbox" (default) or "live". Set PAYONIFY_BASE_URL to override both.
PAYONIFY_ENV="sandbox"

# NewsAPI (server-side only — used by api/news.js, never shipped to the client)
NEWS_API_KEY=your_newsapi_key_here

# SerpApi - the outreach pipeline (api/_serpapi.js) that finds public
# professional profiles when LINKUP has nobody for an ask.
# Server-side ONLY (Vercel env var). Never ship this to the app bundle.
# The free plan is 250 searches a month and every LINKUP member shares that
# pool, so the code reads https://serpapi.com/account.json (costs 0 searches)
# before spending and refuses under a reserve. Rotate the key in Vercel, not here.
SERPAPI_KEY="your_serpapi_key_here"
# Optional overrides; defaults are in OUTREACH in api/_serpapi.js
# OUTREACH_RESERVE_CREDITS=40   # never take the account below this many searches
