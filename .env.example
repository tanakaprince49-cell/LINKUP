# GEMINI_API_KEY: Required for Gemini AI API calls. The server also accepts
# GOOGLE_GENERATIVE_AI_API_KEY, EXPO_PUBLIC_GEMINI_API_KEY or GOOGLE_API_KEY - the
# first one it finds wins. Without any of them (and without ZEN_API_KEY) Linky
# still answers, but in hard-coded sentences, and members notice.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Payonify (Zimbabwe) — LINKUP's single web checkout rail for prepaid
# PLUS / Campaigns terms. Server-side ONLY (Vercel env vars). The Secret Key
# must NEVER reach the app bundle or the git repo. See api/_payonify.js.
#
# Get your keys from https://payonify.co.zw → Developer Settings → API Keys.
# Start on sandbox (pk_test_ / sk_test_); switch PAYONIFY_ENV to "live" only
# once the live credentials (pk_live_ / sk_live_) are in place.
PAYONIFY_PUBLISHABLE_KEY="pk_test_YOUR_KEY_HERE"
PAYONIFY_SECRET_KEY="sk_test_YOUR_KEY_HERE"

# Webhook secret for signature verification. Get this from Payonify dashboard
# → Developer Settings → Webhooks. Long, random, secret.
PAYONIFY_WEBHOOK_SECRET="whsec_YOUR_WEBHOOK_SECRET"

# Where Payonify sends the browser afterwards. Entitlement is granted by the
# webhook, never by the browser landing on successUrl. Any path on the app
# origin works (the web app is a single-page app); these just need to return
# the browser to the app so the client can reconcile the pending payment.
PAYONIFY_SUCCESS_URL="https://linkup-muqu.vercel.app/"
PAYONIFY_CANCEL_URL="https://linkup-muqu.vercel.app/"

# "sandbox" (default) or "live". Set PAYONIFY_BASE_URL to override both.
PAYONIFY_ENV="sandbox"

# NewsAPI (server-side only — used by api/news.js, never shipped to the client)
NEWS_API_KEY=your_newsapi_key_here

# Linky's AI providers (server-side only, used by api/_gemini.js).
# Gemini is the primary. When it errors, is over quota or times out, the same
# prompt is re-sent to OpenCode Zen with the key below, so a member never gets an
# AI outage - and with NEITHER key set, Linky still answers from his own
# deterministic wording. Both are read at request time, so Vercel env changes
# take effect on the next ask. Never expose either to the app bundle.
#
# SOS kill switch: set LINKY_AI_OFF=true to force Linky fully deterministic
# (no Gemini, no Zen, zero model spend) without a redeploy. See GEMINI_SOS_RUNBOOK.md.
# LINKY_AI_OFF=false
ZEN_API_KEY="your_opencode_zen_key_here"
# ZEN_MODEL: which model on that key writes Linky's sentences. Default
# gemini-3.5-flash-lite; a refused name is retried down a short chain. Note an
# OpenCode *free tier* key cannot be used from a server at all - the free models
# answer "OpenCode's free tier can only be used in OpenCode", and paid ones answer
# "No payment method" until billing is added to the workspace.
# Optional: ZEN_API_URL / ZEN_MODEL override the defaults
# (https://opencode.ai/zen/v1/chat/completions, opencode/gemini-2.5-flash).
# ZEN_MODEL="opencode/gemini-2.5-flash"

# SerpApi - the outreach pipeline (api/_serpapi.js) that finds public
# professional profiles when LINKUP has nobody for an ask.
# Server-side ONLY (Vercel env var). Never ship this to the app bundle.
# The free plan is 250 searches a month and every LINKUP member shares that
# pool, so the code reads https://serpapi.com/account.json (costs 0 searches)
# before spending and refuses under a reserve. Rotate the key in Vercel, not here.
SERPAPI_KEY="your_serpapi_key_here"
# Optional overrides; defaults are in OUTREACH in api/_serpapi.js
# OUTREACH_RESERVE_CREDITS=40   # never take the account below this many searches

# How long a Telegram/WhatsApp reply may take before Linky answers honestly that
# it ran out of time, instead of being killed by the platform at 60s and saying
# nothing at all. Floor is 4000. Optional - defaults to 34000.
LINKY_BOT_BUDGET_MS=34000
