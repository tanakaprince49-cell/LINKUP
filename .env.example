# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ContiPay (Zimbabwe) — LINKUP web checkout for prepaid PLUS / Campaigns terms.
# Server-side ONLY (Vercel env vars). The Auth Key and Auth Secret must NEVER
# reach the app bundle or the git repo. See CONTIPAY_SETUP.md.
#
# Sandbox and live credentials are issued separately in the ContiPay developer
# workspace. Start on sandbox; switch CONTIPAY_ENV to "live" only once the live
# credentials are in place.
CONTIPAY_AUTH_KEY="YOUR_CONTIPAY_AUTH_KEY"
CONTIPAY_AUTH_SECRET="YOUR_CONTIPAY_AUTH_SECRET"
CONTIPAY_MERCHANT_ID="1294"

# ContiPay POSTs payment updates here. Must be public HTTPS. No secret in the
# URL — ContiPay sends the webhook token in an Authorization: Bearer header.
CONTIPAY_WEBHOOK_URL="https://linkup-muqu.vercel.app/api/contipayWebhook"

# Webhook auth token. Configure the SAME value in the ContiPay workspace; they
# send it as `Authorization: Bearer <token>`. This is what authenticates the
# endpoint — the payload itself has no signature. Long, random, secret.
CONTIPAY_WEBHOOK_TOKEN="GENERATE_A_LONG_RANDOM_STRING"

# Where ContiPay sends the browser afterwards. Entitlement is granted by the
# webhook, never by the browser landing on successUrl.
CONTIPAY_SUCCESS_URL="https://linkup-muqu.vercel.app/paynow/return"
CONTIPAY_CANCEL_URL="https://linkup-muqu.vercel.app/paynow/cancel"

# "sandbox" (default) or "live". Set CONTIPAY_BASE_URL to override both.
CONTIPAY_ENV="sandbox"

# Optional. Path of ContiPay's transaction status inquiry endpoint, used to
# reconcile payments whose webhook is delayed. Left unset = feature dormant.
# CONTIPAY_STATUS_PATH="/acquire/status"

# NewsAPI (server-side only — used by api/news.js, never shipped to the client)
NEWS_API_KEY=your_newsapi_key_here
