rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ------------------------------------------------------------
    // Helpers
    // ------------------------------------------------------------
    function isSignedIn() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isParticipant(userIds) {
      return isSignedIn() && userIds is list && request.auth.uid in userIds;
    }

    function isPairBlocked(userIds) {
      return userIds is list &&
        userIds.size() == 2 &&
        (
          exists(/databases/$(database)/documents/blocks/$(userIds[0] + "_" + userIds[1])) ||
          exists(/databases/$(database)/documents/blocks/$(userIds[1] + "_" + userIds[0]))
        );
    }

    function isReadableProfile(data) {
      return !data.keys().hasAny(['deleted']) || data.deleted == false;
    }

    function isPublicProfile(data) {
      return isReadableProfile(data) &&
        (!data.keys().hasAny(['isVisible']) || data.isVisible != false) &&
        (!data.keys().hasAny(['isStealthMode']) || data.isStealthMode == false);
    }

    match /{document=**} {
      allow read, write: if isSignedIn();
    }

    // ------------------------------------------------------------
    // Users / public builder profiles
    // ------------------------------------------------------------
    match /users/{userId} {
      function hasDirectMatchWithSignedInUser() {
        return isSignedIn() && (
          exists(/databases/$(database)/documents/matches/$(request.auth.uid + "_" + userId)) ||
          exists(/databases/$(database)/documents/matches/$(userId + "_" + request.auth.uid))
        );
      }

      function isValidUser(data) {
        return data.uid == userId &&
          data.displayName is string &&
          data.displayName.size() > 0 &&
          data.displayName != 'New Builder' &&
          data.displayName.size() <= 100;
      }

      function validOptionalString(data, field, maxSize) {
        return !data.keys().hasAny([field]) ||
          (data[field] is string && data[field].size() <= maxSize);
      }

      function validOptionalList(data, field, maxSize) {
        return !data.keys().hasAny([field]) ||
          (data[field] is list && data[field].size() <= maxSize);
      }

      function validOptionalMap(data, field, maxSize) {
        return !data.keys().hasAny([field]) ||
          (data[field] is map && data[field].keys().size() <= maxSize);
      }

      function validOptionalBool(data, field) {
        return !data.keys().hasAny([field]) || data[field] is bool;
      }

      function validOptionalTimestamp(data, field) {
        return !data.keys().hasAny([field]) || data[field] is timestamp;
      }

      function validOptionalScore(data, field) {
        return !data.keys().hasAny([field]) ||
          ((data[field] is int || data[field] is float) && data[field] >= 0 && data[field] <= 100);
      }

      function validOptionalPoints(data, field) {
        return !data.keys().hasAny([field]) ||
          ((data[field] is int || data[field] is float) && data[field] >= 0 && data[field] <= 1000000);
      }

      function validOptionalReputationMetrics(data) {
        return !data.keys().hasAny(['reputationMetrics']) ||
          (data.reputationMetrics is map &&
            data.reputationMetrics.keys().size() <= 20 &&
            validOptionalScore(data.reputationMetrics, 'reliability') &&
            validOptionalScore(data.reputationMetrics, 'responseRate') &&
            validOptionalScore(data.reputationMetrics, 'collaboration') &&
            validOptionalScore(data.reputationMetrics, 'consistency') &&
            validOptionalScore(data.reputationMetrics, 'completion'));
      }

      function validChangedString(field, maxSize) {
        return !incoming().diff(existing()).affectedKeys().hasAny([field]) ||
          (incoming()[field] is string && incoming()[field].size() <= maxSize);
      }

      function validChangedList(field, maxSize) {
        return !incoming().diff(existing()).affectedKeys().hasAny([field]) ||
          (incoming()[field] is list && incoming()[field].size() <= maxSize);
      }

      function validChangedMap(field, maxSize) {
        return !incoming().diff(existing()).affectedKeys().hasAny([field]) ||
          (incoming()[field] is map && incoming()[field].keys().size() <= maxSize);
      }

      function validChangedBool(field) {
        return !incoming().diff(existing()).affectedKeys().hasAny([field]) ||
          incoming()[field] is bool;
      }

      function validChangedScore(field) {
        return !incoming().diff(existing()).affectedKeys().hasAny([field]) ||
          ((incoming()[field] is int || incoming()[field] is float) && incoming()[field] >= 0 && incoming()[field] <= 100);
      }

      function validChangedPoints(field) {
        return !incoming().diff(existing()).affectedKeys().hasAny([field]) ||
          ((incoming()[field] is int || incoming()[field] is float) && incoming()[field] >= 0 && incoming()[field] <= 1000000);
      }

      function validChangedTimestamp(field) {
        return !incoming().diff(existing()).affectedKeys().hasAny([field]) ||
          incoming()[field] is timestamp;
      }

      function validChangedReputationMetrics() {
        return !incoming().diff(existing()).affectedKeys().hasAny(['reputationMetrics']) ||
          validOptionalReputationMetrics(incoming());
      }

      function validChangedSettings() {
        return !incoming().diff(existing()).affectedKeys().hasAny(['settings']) ||
          validOptionalSettings(incoming());
      }

      function validOptionalSettings(data) {
        return !data.keys().hasAny(['settings']) ||
          (data.settings is map &&
            data.settings.keys().hasOnly([
              'publicDiscovery',
              'stealthMode',
              'turboConnect',
              'hideOnlineStatus',
              'darkMode'
            ]) &&
            (!data.settings.keys().hasAny(['publicDiscovery']) || data.settings.publicDiscovery is bool) &&
            (!data.settings.keys().hasAny(['stealthMode']) || data.settings.stealthMode is bool) &&
            (!data.settings.keys().hasAny(['turboConnect']) || data.settings.turboConnect is bool) &&
            (!data.settings.keys().hasAny(['hideOnlineStatus']) || data.settings.hideOnlineStatus is bool) &&
            (!data.settings.keys().hasAny(['darkMode']) || data.settings.darkMode is bool));
      }

      function validProfileShape(data) {
        return validOptionalString(data, 'username', 30) &&
          validOptionalString(data, 'profileLink', 180) &&
          validOptionalString(data, 'occupation', 80) &&
          validOptionalString(data, 'company', 120) &&
          validOptionalString(data, 'bio', 2000) &&
          validOptionalString(data, 'country', 80) &&
          validOptionalString(data, 'city', 80) &&
          validOptionalString(data, 'goals', 500) &&
          validOptionalString(data, 'experience', 80) &&
          validOptionalString(data, 'personalityType', 80) &&
          validOptionalString(data, 'commitmentLevel', 80) &&
          validOptionalString(data, 'startupStage', 80) &&
          validOptionalString(data, 'fundingStage', 80) &&
          validOptionalString(data, 'availability', 80) &&
          validOptionalString(data, 'timezone', 80) &&
          validOptionalString(data, 'workStyle', 80) &&
          validOptionalString(data, 'networkingIntent', 120) &&
          validOptionalString(data, 'education', 80) &&
          validOptionalString(data, 'teamSizePreference', 80) &&
          validOptionalString(data, 'ambition', 120) &&
          validOptionalString(data, 'profilePic', 900000) &&
          validOptionalString(data, 'coverPhoto', 900000) &&
          validOptionalString(data, 'vibeMedia', 900000) &&
          validOptionalList(data, 'photos', 3) &&
          validOptionalList(data, 'skills', 50) &&
          validOptionalList(data, 'interests', 50) &&
          validOptionalList(data, 'industries', 40) &&
          validOptionalList(data, 'lookingFor', 30) &&
          validOptionalList(data, 'languages', 20) &&
          validOptionalList(data, 'badges', 50) &&
          validOptionalList(data, 'projects', 20) &&
          validOptionalList(data, 'startupIdeas', 20) &&
          validOptionalList(data, 'circles', 20) &&
          validOptionalMap(data, 'personalityAnswers', 30) &&
          validOptionalMap(data, 'roleAnswers', 30) &&
          validOptionalMap(data, 'resume', 10) &&
          validOptionalMap(data, 'socialLinks', 10) &&
          validOptionalBool(data, 'isVisible') &&
          validOptionalBool(data, 'isStealthMode') &&
          validOptionalBool(data, 'turboConnect') &&
          validOptionalBool(data, 'hideOnlineStatus') &&
          validOptionalBool(data, 'remoteOnly') &&
          validOptionalBool(data, 'willingToRelocate') &&
          validOptionalBool(data, 'hasExit') &&
          validOptionalBool(data, 'isPro') &&
          validOptionalString(data, 'plan', 40) &&
          validOptionalString(data, 'subscriptionPlan', 40) &&
          validOptionalString(data, 'subscriptionStatus', 40) &&
          validOptionalBool(data, 'isVerified') &&
          validOptionalString(data, 'verificationProgram', 80) &&
          validOptionalString(data, 'verifiedBy', 128) &&
          validOptionalTimestamp(data, 'verifiedAt') &&
          validOptionalTimestamp(data, 'proUnlockedAt') &&
          validOptionalTimestamp(data, 'subscriptionUpdatedAt') &&
          validOptionalTimestamp(data, 'lastActiveAt') &&
          validOptionalPoints(data, 'reputationScore') &&
          validOptionalScore(data, 'founderScore') &&
          validOptionalPoints(data, 'streakCount') &&
          validOptionalReputationMetrics(data) &&
          validOptionalSettings(data) &&
          (!data.keys().hasAny(['age']) ||
            (data.age is int && (data.age == 0 || (data.age >= 13 && data.age <= 120))));
      }

      function verificationCreateDefaultsOnly() {
        return (!incoming().keys().hasAny(['isVerified']) || incoming().isVerified == false) &&
          (!incoming().keys().hasAny(['verificationProgram']) || incoming().verificationProgram == '') &&
          (!incoming().keys().hasAny(['verifiedBy']) || incoming().verifiedBy == '') &&
          !incoming().keys().hasAny(['verifiedAt']);
      }

      function safeProfileCreateKeys() {
        return incoming().keys().hasOnly([
          'uid', 'displayName', 'username', 'profileLink',
          'occupation', 'company', 'bio',
          'age', 'country', 'city',
          'skills', 'interests', 'goals', 'industries',
          'experience', 'personalityType', 'personalityAnswers', 'roleAnswers',
          'commitmentLevel', 'startupStage', 'fundingStage',
          'availability', 'timezone', 'languages', 'workStyle',
          'lookingFor', 'networkingIntent',
          'profilePic', 'photos', 'coverPhoto', 'vibeMedia',
          'projects', 'portfolioLinks', 'startupIdeas', 'resume', 'badges',
          'socialLinks', 'education', 'remoteOnly', 'willingToRelocate',
          'teamSizePreference', 'ambition',
          'isVisible', 'isStealthMode', 'turboConnect', 'hideOnlineStatus',
          'isPro', 'plan', 'subscriptionPlan', 'subscriptionStatus',
          'proUnlockedAt', 'subscriptionUpdatedAt',
          'settings',
          'isVerified', 'verificationProgram', 'verifiedBy',
          'onboarded', 'createdAt',
          'lastActiveAt',
          'reputationScore', 'streakCount', 'founderScore', 'reputationMetrics',
          'circles', 'aiMatchInsights'
        ]);
      }

      function validOwnProfileWrite(data) {
        return (!data.keys().hasAny(['uid']) || data.uid == userId) &&
          (!data.keys().hasAny(['displayName']) ||
            (data.displayName is string &&
              data.displayName.size() > 0 &&
              data.displayName != 'New Builder' &&
              data.displayName.size() <= 100));
      }

      function safeProfileUpdateKeys() {
        return incoming().diff(existing()).affectedKeys().hasOnly([
          'uid',
          'displayName', 'username', 'profileLink',
          'occupation', 'company', 'bio',
          'age', 'country', 'city',
          'skills', 'interests', 'goals', 'industries',
          'experience', 'personalityType', 'personalityAnswers', 'roleAnswers',
          'commitmentLevel', 'startupStage', 'fundingStage',
          'availability', 'timezone', 'languages', 'workStyle',
          'lookingFor', 'networkingIntent',
          'profilePic', 'photos', 'coverPhoto', 'vibeMedia',
          'projects', 'portfolioLinks', 'startupIdeas', 'resume', 'badges',
          'socialLinks',
          'education', 'remoteOnly', 'willingToRelocate', 'teamSizePreference',
          'ambition',
          'isVisible', 'isStealthMode', 'turboConnect', 'hideOnlineStatus',
          'isPro', 'plan', 'subscriptionPlan', 'subscriptionStatus',
          'proUnlockedAt', 'subscriptionUpdatedAt',
          'settings',
          'isVerified', 'verificationProgram', 'verifiedBy',
          'onboarded',
          'lastActiveAt',
          'reputationScore', 'streakCount', 'founderScore', 'reputationMetrics',
          'aiMatchInsights',
          'circles'
        ]);
      }

      function verificationFieldsSafe() {
        return (!incoming().keys().hasAny(['isVerified']) || incoming().isVerified == false) &&
          (!incoming().keys().hasAny(['verificationProgram']) || incoming().verificationProgram == '') &&
          (!incoming().keys().hasAny(['verifiedBy']) || incoming().verifiedBy == '') &&
          !incoming().keys().hasAny(['verifiedAt']);
      }

      function validProUnlockData(data) {
        return data.uid == userId &&
          data.displayName is string &&
          data.displayName.size() > 0 &&
          data.displayName != 'New Builder' &&
          data.displayName.size() <= 100 &&
          data.isPro == true &&
          data.plan in ['pro', 'plus'] &&
          data.subscriptionPlan in ['pro', 'plus'] &&
          data.subscriptionStatus == 'active' &&
          validOptionalString(data, 'profileLink', 180) &&
          (!data.keys().hasAny(['isVerified']) || data.isVerified == true) &&
          (!data.keys().hasAny(['verificationProgram']) || data.verificationProgram in ['LINKUP Pro', 'LINKUP PLUS']) &&
          (!data.keys().hasAny(['verifiedBy']) || data.verifiedBy in ['LINKUP Pro', 'LINKUP PLUS']) &&
          validOptionalTimestamp(data, 'verifiedAt') &&
          (!data.keys().hasAny(['turboConnect']) || data.turboConnect == true) &&
          validOptionalSettings(data) &&
          (!data.keys().hasAny(['settings']) ||
            (!data.settings.keys().hasAny(['turboConnect']) || data.settings.turboConnect == true)) &&
          validOptionalTimestamp(data, 'proUnlockedAt') &&
          validOptionalTimestamp(data, 'subscriptionUpdatedAt');
      }

      function safeProUnlockCreateKeys() {
        return incoming().keys().hasOnly([
          'uid',
          'displayName',
          'profileLink',
          'isPro',
          'plan',
          'subscriptionPlan',
          'subscriptionStatus',
          'isVerified',
          'verificationProgram',
          'verifiedBy',
          'verifiedAt',
          'turboConnect',
          'settings',
          'proUnlockedAt',
          'subscriptionUpdatedAt'
        ]);
      }

      function safeProUnlockUpdateKeys() {
        return incoming().diff(existing()).affectedKeys().hasOnly([
          'uid',
          'displayName',
          'profileLink',
          'isPro',
          'plan',
          'subscriptionPlan',
          'subscriptionStatus',
          'isVerified',
          'verificationProgram',
          'verifiedBy',
          'verifiedAt',
          'turboConnect',
          'settings',
          'proUnlockedAt',
          'subscriptionUpdatedAt'
        ]);
      }

      function validProCancelData(data) {
        return data.uid == userId &&
          data.displayName is string &&
          data.displayName.size() > 0 &&
          data.displayName != 'New Builder' &&
          data.displayName.size() <= 100 &&
          data.isPro == false &&
          data.plan == 'free' &&
          data.subscriptionPlan == 'free' &&
          data.subscriptionStatus in ['canceled', 'cancelled', 'inactive', 'expired'] &&
          validOptionalString(data, 'profileLink', 180) &&
          data.isVerified == false &&
          (!data.keys().hasAny(['verificationProgram']) || data.verificationProgram == '') &&
          (!data.keys().hasAny(['verifiedBy']) || data.verifiedBy == '') &&
          !data.keys().hasAny(['verifiedAt']) &&
          (!data.keys().hasAny(['turboConnect']) || data.turboConnect == false) &&
          validOptionalSettings(data) &&
          (!data.keys().hasAny(['settings']) ||
            (!data.settings.keys().hasAny(['turboConnect']) || data.settings.turboConnect == false)) &&
          validOptionalTimestamp(data, 'subscriptionCanceledAt') &&
          validOptionalTimestamp(data, 'subscriptionUpdatedAt');
      }

      function safeProCancelUpdateKeys() {
        return incoming().diff(existing()).affectedKeys().hasOnly([
          'uid',
          'displayName',
          'profileLink',
          'isPro',
          'plan',
          'subscriptionPlan',
          'subscriptionStatus',
          'subscriptionCanceledAt',
          'subscriptionUpdatedAt',
          'isVerified',
          'verificationProgram',
          'verifiedBy',
          'verifiedAt',
          'turboConnect',
          'settings'
        ]);
      }

      function validProfileUpdateShape() {
        return validChangedString('username', 30) &&
          validChangedString('profileLink', 180) &&
          validChangedString('occupation', 80) &&
          validChangedString('company', 120) &&
          validChangedString('bio', 2000) &&
          validChangedString('country', 80) &&
          validChangedString('city', 80) &&
          validChangedString('goals', 500) &&
          validChangedString('experience', 80) &&
          validChangedString('personalityType', 80) &&
          validChangedString('commitmentLevel', 80) &&
          validChangedString('startupStage', 80) &&
          validChangedString('fundingStage', 80) &&
          validChangedString('availability', 80) &&
          validChangedString('timezone', 80) &&
          validChangedString('workStyle', 80) &&
          validChangedString('networkingIntent', 120) &&
          validChangedString('education', 80) &&
          validChangedString('teamSizePreference', 80) &&
          validChangedString('ambition', 120) &&
          validChangedString('profilePic', 900000) &&
          validChangedString('coverPhoto', 900000) &&
          validChangedString('vibeMedia', 900000) &&
          validChangedString('verificationProgram', 80) &&
          validChangedString('verifiedBy', 128) &&
          validChangedList('photos', 3) &&
          validChangedList('skills', 50) &&
          validChangedList('interests', 50) &&
          validChangedList('industries', 40) &&
          validChangedList('lookingFor', 30) &&
          validChangedList('languages', 20) &&
          validChangedList('badges', 50) &&
          validChangedList('projects', 20) &&
          validChangedList('startupIdeas', 20) &&
          validChangedList('circles', 20) &&
          validChangedMap('personalityAnswers', 30) &&
          validChangedMap('roleAnswers', 30) &&
          validChangedMap('resume', 10) &&
          validChangedMap('socialLinks', 10) &&
          validChangedBool('isVisible') &&
          validChangedBool('isStealthMode') &&
          validChangedBool('turboConnect') &&
          validChangedBool('hideOnlineStatus') &&
          validChangedBool('remoteOnly') &&
          validChangedBool('willingToRelocate') &&
          validChangedBool('hasExit') &&
          validChangedBool('isPro') &&
          validChangedString('plan', 40) &&
          validChangedString('subscriptionPlan', 40) &&
          validChangedString('subscriptionStatus', 40) &&
          validChangedBool('isVerified') &&
          validChangedTimestamp('lastActiveAt') &&
          validChangedTimestamp('proUnlockedAt') &&
          validChangedTimestamp('subscriptionUpdatedAt') &&
          validChangedPoints('reputationScore') &&
          validChangedPoints('streakCount') &&
          validChangedScore('founderScore') &&
          validChangedReputationMetrics() &&
          validChangedSettings() &&
          (!incoming().diff(existing()).affectedKeys().hasAny(['age']) ||
            (incoming().age is int && (incoming().age == 0 || (incoming().age >= 13 && incoming().age <= 120))));
      }

      function safePushTokenCleanup() {
        return existing().keys().hasAny(['pushTokens']) &&
          !incoming().keys().hasAny(['pushTokens']) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['pushTokens']);
      }

      allow get: if isOwner(userId) || isPublicProfile(existing()) || hasDirectMatchWithSignedInUser() || (
        isSignedIn() &&
        isReadableProfile(existing()) &&
        !exists(/databases/$(database)/documents/blocks/$(userId + "_" + request.auth.uid))
      );

      // Search/discovery fetches a signed-in profile pool and the app filters stealth/hidden
      // profiles locally. This keeps older profiles without visibility fields discoverable.
      allow list: if isSignedIn();

      allow create: if isOwner(userId) && validOwnProfileWrite(incoming());

      allow update: if isOwner(userId) && validOwnProfileWrite(incoming());

      allow delete: if isOwner(userId);
    }

    // Lightweight discovery index. The app reads this instead of the heavy users/{uid}
    // documents so Android does not download large profile photo/gallery payloads.
    match /publicProfiles/{userId} {
      function validPublicString(data, field, maxSize) {
        return !data.keys().hasAny([field]) ||
          (data[field] is string && data[field].size() <= maxSize);
      }

      function validPublicList(data, field, maxSize) {
        return !data.keys().hasAny([field]) ||
          (data[field] is list && data[field].size() <= maxSize);
      }

      function validPublicBool(data, field) {
        return !data.keys().hasAny([field]) || data[field] is bool;
      }

      function validPublicNumber(data, field, maxValue) {
        return !data.keys().hasAny([field]) ||
          (data[field] is int && data[field] >= 0 && data[field] <= maxValue);
      }

      function validPublicTimestampish(data, field) {
        return !data.keys().hasAny([field]) ||
          data[field] == null ||
          data[field] is timestamp ||
          (data[field] is string && data[field].size() <= 80);
      }

      function validPublicProfile(data) {
        return data.uid == userId &&
          data.keys().hasOnly([
            'uid', 'displayName', 'username', 'bio', 'profilePic',
            'occupation', 'company', 'country', 'city', 'age',
            'skills', 'interests', 'industries', 'lookingFor',
            'goals', 'experience', 'personalityType', 'commitmentLevel',
            'startupStage', 'fundingStage', 'availability', 'timezone',
            'languages', 'workStyle', 'education', 'networkingIntent',
            'ambition', 'remoteOnly', 'willingToRelocate', 'teamSizePreference',
            'projects', 'startupIdeas',
            'profileViews', 'profileClicks', 'profileSaves', 'responseRate',
            'isVisible', 'isStealthMode', 'turboConnect', 'hideOnlineStatus',
            'isVerified', 'verificationProgram', 'isPro', 'plan',
            'subscriptionPlan', 'subscriptionStatus',
            'onboarded', 'deleted', 'lastActiveAt', 'updatedAt'
          ]) &&
          validPublicString(data, 'displayName', 100) &&
          validPublicString(data, 'username', 40) &&
          validPublicString(data, 'bio', 700) &&
          validPublicString(data, 'profilePic', 900000) &&
          validPublicString(data, 'occupation', 100) &&
          validPublicString(data, 'company', 120) &&
          validPublicString(data, 'country', 80) &&
          validPublicString(data, 'city', 80) &&
          validPublicString(data, 'goals', 420) &&
          validPublicString(data, 'experience', 80) &&
          validPublicString(data, 'personalityType', 80) &&
          validPublicString(data, 'commitmentLevel', 80) &&
          validPublicString(data, 'startupStage', 80) &&
          validPublicString(data, 'fundingStage', 80) &&
          validPublicString(data, 'availability', 80) &&
          validPublicString(data, 'timezone', 80) &&
          validPublicString(data, 'workStyle', 80) &&
          validPublicString(data, 'education', 80) &&
          validPublicString(data, 'networkingIntent', 120) &&
          validPublicString(data, 'ambition', 120) &&
          validPublicString(data, 'teamSizePreference', 80) &&
          validPublicString(data, 'verificationProgram', 80) &&
          validPublicString(data, 'plan', 40) &&
          validPublicString(data, 'subscriptionPlan', 40) &&
          validPublicString(data, 'subscriptionStatus', 40) &&
          validPublicString(data, 'updatedAt', 80) &&
          validPublicList(data, 'skills', 20) &&
          validPublicList(data, 'interests', 20) &&
          validPublicList(data, 'industries', 16) &&
          validPublicList(data, 'lookingFor', 16) &&
          validPublicList(data, 'languages', 12) &&
          validPublicList(data, 'projects', 5) &&
          validPublicList(data, 'startupIdeas', 8) &&
          validPublicBool(data, 'remoteOnly') &&
          validPublicBool(data, 'willingToRelocate') &&
          validPublicBool(data, 'isVisible') &&
          validPublicBool(data, 'isStealthMode') &&
          validPublicBool(data, 'turboConnect') &&
          validPublicBool(data, 'hideOnlineStatus') &&
          validPublicBool(data, 'isVerified') &&
          validPublicBool(data, 'isPro') &&
          validPublicBool(data, 'onboarded') &&
          validPublicBool(data, 'deleted') &&
          validPublicNumber(data, 'age', 120) &&
          validPublicNumber(data, 'profileViews', 1000000) &&
          validPublicNumber(data, 'profileClicks', 1000000) &&
          validPublicNumber(data, 'profileSaves', 1000000) &&
          validPublicNumber(data, 'responseRate', 100) &&
          validPublicTimestampish(data, 'lastActiveAt');
      }

      allow get, list: if isSignedIn();
      allow create, update: if isOwner(userId) && validPublicProfile(incoming());
      allow delete: if isOwner(userId);
    }

    // Owner-only private user data. Never store secrets or device tokens in public profiles.
    match /userPrivate/{userId} {
      function validPrivateUserDoc(data) {
        return data.keys().hasOnly([
          'pushTokens',
          'webNotificationsEnabled',
          'webNotificationsUpdatedAt',
          'savedSearchAlerts',
          'updatedAt'
        ]) &&
          (!data.keys().hasAny(['pushTokens']) ||
            (data.pushTokens is list && data.pushTokens.size() <= 20)) &&
          (!data.keys().hasAny(['savedSearchAlerts']) ||
            (data.savedSearchAlerts is list && data.savedSearchAlerts.size() <= 25)) &&
          (!data.keys().hasAny(['webNotificationsEnabled']) || data.webNotificationsEnabled is bool);
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create, update: if isOwner(userId) && validPrivateUserDoc(incoming());
      allow delete: if isOwner(userId);
    }

    // ------------------------------------------------------------
    // Presence / online status
    // ------------------------------------------------------------
    match /presence/{userId} {
      function isValidPresence(data) {
        return data.keys().hasOnly(['isOnline', 'lastActiveAt']) &&
          data.isOnline is bool;
      }

      allow get: if isOwner(userId) || (
        isSignedIn() &&
        get(/databases/$(database)/documents/users/$(userId)).data.hideOnlineStatus != true
      );
      allow list: if false;
      allow create: if isOwner(userId) && isValidPresence(incoming());
      allow update: if isOwner(userId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['isOnline', 'lastActiveAt']) &&
        isValidPresence(incoming());
      allow delete: if isOwner(userId);
    }

    // ------------------------------------------------------------
    // Blocks
    // ------------------------------------------------------------
    match /blocks/{blockId} {
      function userIsInBlock(data) {
        return data.blockedById == request.auth.uid || data.blockedUserId == request.auth.uid;
      }

      function isRequesterBlockPath() {
        return isSignedIn() && blockId.matches('^' + request.auth.uid + '_[a-zA-Z0-9_\\-]+$');
      }

      allow get: if isRequesterBlockPath() || (isSignedIn() && userIsInBlock(existing()));
      allow list: if isSignedIn() && userIsInBlock(existing());
      allow create: if isSignedIn() &&
        incoming().keys().hasOnly(['blockedById', 'blockedUserId', 'timestamp']) &&
        blockId == request.auth.uid + "_" + incoming().blockedUserId &&
        incoming().blockedById == request.auth.uid &&
        isValidId(incoming().blockedUserId) &&
        incoming().blockedUserId != request.auth.uid &&
        incoming().timestamp == request.time;
      allow delete: if isSignedIn() && existing().blockedById == request.auth.uid;
      allow update: if false;
    }

    // ------------------------------------------------------------
    // Swipes / likes
    // ------------------------------------------------------------
    match /swipes/{swipeId} {
      function userIsInSwipe(data) {
        return data.fromId == request.auth.uid || data.toId == request.auth.uid;
      }

      allow get, list: if isSignedIn() && userIsInSwipe(existing());
      allow create: if isSignedIn() &&
        incoming().keys().hasOnly(['fromId', 'toId', 'type', 'timestamp']) &&
        incoming().fromId == request.auth.uid &&
        isValidId(incoming().toId) &&
        incoming().toId != request.auth.uid &&
        incoming().type in ['like', 'skip'] &&
        incoming().timestamp == request.time;
      allow update, delete: if false;
    }

    // ------------------------------------------------------------
    // Idea swipes / "Tinder for Ideas"
    // ------------------------------------------------------------
    match /ideaSwipes/{swipeId} {
      function validIdeaSwipe(data) {
        return data.keys().hasOnly([
          'ideaId', 'ideaOwnerId', 'ideaTitle',
          'swiperId', 'swiperName', 'swiperPic',
          'direction', 'createdAt'
        ]) &&
        data.ideaId is string &&
        data.ideaId.size() > 0 &&
        data.ideaId.size() <= 160 &&
        data.ideaOwnerId is string &&
        isValidId(data.ideaOwnerId) &&
        data.swiperId == request.auth.uid &&
        data.ideaOwnerId != request.auth.uid &&
        data.direction == 'right' &&
        data.createdAt == request.time &&
        (!data.keys().hasAny(['ideaTitle']) || (data.ideaTitle is string && data.ideaTitle.size() <= 180)) &&
        (!data.keys().hasAny(['swiperName']) || (data.swiperName is string && data.swiperName.size() <= 120)) &&
        (!data.keys().hasAny(['swiperPic']) || (data.swiperPic is string && data.swiperPic.size() <= 900000));
      }

      allow get: if isSignedIn() && (existing().swiperId == request.auth.uid || existing().ideaOwnerId == request.auth.uid);
      allow list: if isSignedIn();
      allow create, update: if isSignedIn() &&
        swipeId == incoming().ideaId + "_" + request.auth.uid &&
        validIdeaSwipe(incoming());
      allow delete: if isSignedIn() && existing().swiperId == request.auth.uid;
    }

    // ------------------------------------------------------------
    // Connection requests / permission to start chats
    // ------------------------------------------------------------
    match /connectionRequests/{requestId} {
      function requestPathInvolvesSignedInUser() {
        return isSignedIn() &&
          (
            requestId.matches('^' + request.auth.uid + '_[a-zA-Z0-9_\\-]+$') ||
            requestId.matches('^[a-zA-Z0-9_\\-]+_' + request.auth.uid + '$')
          );
      }

      function userIsInConnectionRequest(data) {
        return isSignedIn() && (data.senderId == request.auth.uid || data.recipientId == request.auth.uid);
      }

      function validConnectionRequestBase(data) {
        return data.senderId is string &&
          isValidId(data.senderId) &&
          data.recipientId is string &&
          isValidId(data.recipientId) &&
          data.senderId != data.recipientId &&
          data.senderName is string &&
          data.senderName.size() > 0 &&
          data.senderName.size() <= 120 &&
          data.senderPic is string &&
          data.senderPic.size() <= 900000 &&
          (!data.keys().hasAny(['message']) || (data.message is string && data.message.size() <= 600)) &&
          (!data.keys().hasAny(['contextType']) || data.contextType == 'idea') &&
          (!data.keys().hasAny(['ideaId']) || (data.ideaId is string && data.ideaId.size() <= 120)) &&
          (!data.keys().hasAny(['ideaTitle']) || (data.ideaTitle is string && data.ideaTitle.size() <= 140));
      }

      allow get: if requestPathInvolvesSignedInUser() || userIsInConnectionRequest(existing());
      allow list: if false;
      allow create: if isSignedIn() &&
        incoming().keys().hasOnly([
          'senderId', 'recipientId', 'senderName', 'senderPic',
          'status', 'message', 'contextType', 'ideaId', 'ideaTitle',
          'createdAt', 'updatedAt'
        ]) &&
        requestId == request.auth.uid + "_" + incoming().recipientId &&
        validConnectionRequestBase(incoming()) &&
        incoming().senderId == request.auth.uid &&
        incoming().status == 'pending' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSignedIn() &&
        existing().recipientId == request.auth.uid &&
        existing().status == 'pending' &&
        incoming().senderId == existing().senderId &&
        incoming().recipientId == existing().recipientId &&
        incoming().senderName == existing().senderName &&
        incoming().senderPic == existing().senderPic &&
        (!existing().keys().hasAny(['message']) || incoming().message == existing().message) &&
        (!existing().keys().hasAny(['contextType']) || incoming().contextType == existing().contextType) &&
        (!existing().keys().hasAny(['ideaId']) || incoming().ideaId == existing().ideaId) &&
        (!existing().keys().hasAny(['ideaTitle']) || incoming().ideaTitle == existing().ideaTitle) &&
        incoming().status in ['approved', 'rejected'] &&
        incoming().reviewedAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reviewedAt', 'updatedAt']);
      allow delete: if false;
    }

    // ------------------------------------------------------------
    // AI match cache (Cloud Functions/Admin SDK writes only)
    // ------------------------------------------------------------
    match /aiMatches/{pairId} {
      allow get: if isSignedIn() &&
        (existing().u1 == request.auth.uid || existing().u2 == request.auth.uid);
      allow list, create, update, delete: if false;
    }

    // ------------------------------------------------------------
    // Matches / conversations / messages
    // ------------------------------------------------------------
    match /matches/{matchId} {
      function validMatchUsers(userIds) {
        return userIds is list &&
          userIds.size() == 2 &&
          request.auth.uid in userIds &&
          userIds[0] is string &&
          userIds[1] is string;
      }

      function validParticipants(data) {
        return data.participants is map &&
          data.participants.keys().hasOnly(data.userIds) &&
          data.participants[data.userIds[0]] == true &&
          data.participants[data.userIds[1]] == true;
      }

      function validConversationProfile(profile, uid) {
        return profile is map &&
          profile.keys().hasOnly([
            'uid', 'displayName', 'profilePic',
            'isVerified', 'hideOnlineStatus'
          ]) &&
          profile.uid == uid &&
          profile.displayName is string &&
          profile.displayName.size() > 0 &&
          profile.displayName.size() <= 100 &&
          profile.profilePic is string &&
          profile.profilePic.size() <= 900000 &&
          (!profile.keys().hasAny(['isVerified']) || profile.isVerified is bool) &&
          (!profile.keys().hasAny(['hideOnlineStatus']) || profile.hideOnlineStatus is bool);
      }

      function validParticipantProfiles(data) {
        return !data.keys().hasAny(['participantProfiles']) ||
          (
            data.participantProfiles is map &&
            data.participantProfiles.keys().hasOnly(data.userIds) &&
            validConversationProfile(data.participantProfiles[data.userIds[0]], data.userIds[0]) &&
            validConversationProfile(data.participantProfiles[data.userIds[1]], data.userIds[1])
          );
      }

      function participantsValidOrMissing(data) {
        return !data.keys().hasAny(['participants']) || validParticipants(data);
      }

      function isParticipantMap(participants) {
        return isSignedIn() && participants is map && participants[request.auth.uid] == true;
      }

      function validMatchCreate(data) {
        return data.keys().hasOnly([
          'userIds', 'timestamp',
          'participants',
          'participantProfiles',
          'lastMessage', 'lastMessageTime',
          'pinnedBy', 'archivedBy', 'importantBy', 'mutedUntilBy',
          'deletedBy', 'confidentialBy',
          'unreadBy', 'typingBy'
        ]) &&
        validMatchUsers(data.userIds) &&
        validParticipants(data) &&
        validParticipantProfiles(data) &&
        !isPairBlocked(data.userIds);
      }

      function validParticipantArray(data, field) {
        return !data.keys().hasAny([field]) ||
          (data[field] is list && data[field].size() <= 2 && data[field].hasOnly(data.userIds));
      }

      function validMatchMutableData(data) {
        return validParticipantArray(data, 'pinnedBy') &&
          validParticipantArray(data, 'archivedBy') &&
          validParticipantArray(data, 'importantBy') &&
          validParticipantArray(data, 'deletedBy') &&
          validParticipantArray(data, 'confidentialBy') &&
          (!data.keys().hasAny(['mutedUntilBy']) ||
            (data.mutedUntilBy is map && data.mutedUntilBy.keys().hasOnly(data.userIds))) &&
          (!data.keys().hasAny(['unreadBy']) ||
            (data.unreadBy is map && data.unreadBy.keys().hasOnly(data.userIds))) &&
          (!data.keys().hasAny(['typingBy']) ||
            (data.typingBy is map && data.typingBy.keys().hasOnly(data.userIds))) &&
          (!data.keys().hasAny(['lastMessage']) ||
            (data.lastMessage is string && data.lastMessage.size() <= 4000)) &&
          validParticipantProfiles(data);
      }

      function validMatchUpdate() {
        return (
            (existing().keys().hasAny(['userIds']) && incoming().userIds == existing().userIds) ||
            (!existing().keys().hasAny(['userIds']) && validMatchUsers(incoming().userIds))
          ) &&
          participantsValidOrMissing(incoming()) &&
          validMatchMutableData(incoming()) &&
          (!incoming().diff(existing()).affectedKeys().hasAny(['timestamp']) ||
            incoming().timestamp == request.time) &&
          (!incoming().diff(existing()).affectedKeys().hasAny(['lastMessageTime']) ||
            incoming().lastMessageTime == request.time) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'userIds',
            'timestamp', 'participants',
            'participantProfiles',
            'lastMessage', 'lastMessageTime',
            'pinnedBy', 'archivedBy', 'importantBy', 'mutedUntilBy',
            'deletedBy', 'confidentialBy',
            'unreadBy', 'typingBy'
          ]);
      }

      allow get: if isParticipant(existing().userIds) || isParticipantMap(existing().participants);
      allow list: if isParticipantMap(existing().participants);
      allow create: if isSignedIn() && validMatchCreate(incoming());
      allow update: if (isParticipant(existing().userIds) || isParticipantMap(existing().participants)) && validMatchUpdate();
      allow delete: if false;

      match /messages/{messageId} {
        function canUseConversation() {
          return isParticipant(get(/databases/$(database)/documents/matches/$(matchId)).data.userIds) &&
            !isPairBlocked(get(/databases/$(database)/documents/matches/$(matchId)).data.userIds);
        }

        function validMessage(data) {
          return data.keys().hasOnly([
            'senderId', 'content', 'timestamp', 'type',
            'mediaUrl', 'mediaName', 'mediaType', 'mediaSize',
            'replyToMessageId', 'replyToSenderId', 'replyToText'
          ]) &&
          data.senderId == request.auth.uid &&
          data.content is string &&
          data.content.size() > 0 &&
          data.content.size() <= 4000 &&
          data.type in ['text', 'image', 'video'] &&
          (
            data.type == 'text' ||
            (
              data.mediaUrl is string &&
              data.mediaUrl.size() <= 900000 &&
              data.mediaName is string &&
              data.mediaName.size() <= 180 &&
              data.mediaType is string &&
              data.mediaType.size() <= 80 &&
              data.mediaSize is int &&
              data.mediaSize >= 0 &&
              (
                (data.type == 'image' && data.mediaType.matches('^image/') && data.mediaSize <= 10485760) ||
                (data.type == 'video' && data.mediaType.matches('^video/') && data.mediaSize <= 78643200)
              )
            )
          ) &&
          data.timestamp == request.time;
        }

        allow read: if canUseConversation();
        allow create: if canUseConversation() && validMessage(incoming());
        allow delete: if canUseConversation() && existing().senderId == request.auth.uid;
        allow update: if false;
      }
    }

    // ------------------------------------------------------------
    // In-app notifications
    // ------------------------------------------------------------
    match /notifications/{notificationId} {
      function isNotificationOwner(data) {
        return isSignedIn() && data.userId == request.auth.uid;
      }

      function validNotification(data) {
        return data.keys().hasOnly([
          'userId', 'fromId', 'fromName', 'fromPic',
          'type', 'content', 'matchId', 'requestId',
          'isRead', 'timestamp'
        ]) &&
        data.userId is string &&
        isValidId(data.userId) &&
        data.isRead == false &&
        data.content is string &&
        data.content.size() <= 500 &&
        data.type in [
          'like', 'match', 'view', 'message', 'comment', 'system',
          'connection_request', 'connection_approved', 'connection_rejected',
          'game_challenge'
        ] &&
        data.timestamp == request.time &&
        (!data.keys().hasAny(['fromId']) || isValidId(data.fromId)) &&
        (!data.keys().hasAny(['matchId']) || isValidId(data.matchId)) &&
        (!data.keys().hasAny(['requestId']) || isValidId(data.requestId)) &&
        (
          data.userId == request.auth.uid ||
          (data.keys().hasAny(['fromId']) && data.fromId == request.auth.uid)
        );
      }

      allow get, list: if isNotificationOwner(existing());
      allow create: if isSignedIn() && validNotification(incoming());
      allow update: if isNotificationOwner(existing()) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['isRead']) &&
        incoming().isRead is bool;
      allow delete: if isNotificationOwner(existing());
    }

    // ------------------------------------------------------------
    // Saved builder profiles
    // ------------------------------------------------------------
    match /savedProfiles/{saveId} {
      function isSavedProfileOwner(data) {
        return isSignedIn() && data.ownerId == request.auth.uid;
      }

      function isRequesterSavedProfilePath() {
        return isSignedIn() &&
          saveId.matches('^' + request.auth.uid + '_[a-zA-Z0-9_\\-]+$');
      }

      function validSavedProfile(data) {
        return data.keys().hasOnly([
          'ownerId', 'profileId', 'ownerName', 'ownerPic', 'profileName', 'profilePic',
          'createdAt', 'updatedAt'
        ]) &&
        data.ownerId == request.auth.uid &&
        isValidId(data.profileId) &&
        data.profileId != request.auth.uid &&
        saveId == request.auth.uid + "_" + data.profileId &&
        (!data.keys().hasAny(['ownerName']) || (data.ownerName is string && data.ownerName.size() <= 100)) &&
        (!data.keys().hasAny(['ownerPic']) || (data.ownerPic is string && data.ownerPic.size() <= 900000)) &&
        (!data.keys().hasAny(['profileName']) || (data.profileName is string && data.profileName.size() <= 100)) &&
        (!data.keys().hasAny(['profilePic']) || (data.profilePic is string && data.profilePic.size() <= 900000));
      }

      allow get: if isRequesterSavedProfilePath() || isSavedProfileOwner(existing());
      allow list: if isSavedProfileOwner(existing()) || (
        isSignedIn() && existing().profileId == request.auth.uid
      );
      allow create: if isSignedIn() && validSavedProfile(incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isSavedProfileOwner(existing()) && validSavedProfile(incoming()) &&
        incoming().ownerId == existing().ownerId &&
        incoming().profileId == existing().profileId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isSavedProfileOwner(existing());
    }

    // ------------------------------------------------------------
    // Game challenges
    // ------------------------------------------------------------
    match /gameChallenges/{challengeDocId} {
      function userIsInChallenge(data) {
        return isSignedIn() && (data.senderId == request.auth.uid || data.recipientId == request.auth.uid);
      }

      allow get: if isSignedIn() && userIsInChallenge(existing());
      allow list: if isSignedIn() && (
        existing().recipientId == request.auth.uid || existing().senderId == request.auth.uid
      );
      allow create: if isSignedIn() &&
        incoming().keys().hasOnly([
          'id', 'senderId', 'recipientId', 'gameType',
          'senderName', 'senderPic', 'message',
          'senderScore', 'senderPlayedAt',
          'senderJoined', 'recipientJoined',
          'status', 'createdAt'
        ]) &&
        incoming().senderId == request.auth.uid &&
        incoming().recipientId is string &&
        isValidId(incoming().recipientId) &&
        incoming().recipientId != request.auth.uid &&
        incoming().gameType in ['founderflip', 'pitchperfect', 'networkquiz'] &&
        incoming().status == 'pending' &&
        incoming().createdAt is number &&
        challengeDocId == incoming().id &&
        (!incoming().keys().hasAny(['senderPic']) || (incoming().senderPic is string && incoming().senderPic.size() <= 900000)) &&
        (!incoming().keys().hasAny(['message']) || (incoming().message is string && incoming().message.size() <= 500));
      allow update: if isSignedIn() && userIsInChallenge(existing()) && (
        // Respond (accept/decline) — only when pending
        (existing().status == 'pending' &&
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'respondedAt']) &&
          incoming().status in ['accepted', 'declined'] &&
          incoming().respondedAt is number) ||
        // Score submission or completion — only when accepted
        (existing().status == 'accepted' &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'senderScore', 'senderPlayedAt',
            'recipientScore', 'recipientPlayedAt',
            'completedAt', 'status',
            'senderJoined', 'recipientJoined',
          ]) &&
          (!incoming().keys().hasAny(['senderScore']) || incoming().senderScore is number) &&
          (!incoming().keys().hasAny(['senderPlayedAt']) || incoming().senderPlayedAt is number) &&
          (!incoming().keys().hasAny(['recipientScore']) || incoming().recipientScore is number) &&
          (!incoming().keys().hasAny(['recipientPlayedAt']) || incoming().recipientPlayedAt is number) &&
          (!incoming().keys().hasAny(['completedAt']) || incoming().completedAt is number) &&
          (!incoming().keys().hasAny(['status']) || incoming().status == 'completed'))
      );
      allow delete: if false;
    }

    // ------------------------------------------------------------
    // Profile analytics / viewers
    // ------------------------------------------------------------
    match /profileViews/{viewId} {
      function isRequesterProfileViewPath() {
        return isSignedIn() &&
          (
            viewId.matches('^[a-zA-Z0-9_\\-]+_' + request.auth.uid + '$') ||
            viewId.matches('^' + request.auth.uid + '_[a-zA-Z0-9_\\-]+$')
          );
      }

      function validProfileViewCreate(data) {
        return data.keys().hasOnly([
          'profileId', 'viewerId', 'viewerName', 'viewerPic',
          'createdAt', 'lastViewedAt'
        ]) &&
        data.profileId is string &&
        isValidId(data.profileId) &&
        data.viewerId == request.auth.uid &&
        data.profileId != request.auth.uid &&
        viewId == data.profileId + "_" + request.auth.uid &&
        data.createdAt == request.time &&
        data.lastViewedAt == request.time;
      }

      function validProfileViewUpdate() {
        return existing().viewerId == request.auth.uid &&
          incoming().profileId == existing().profileId &&
          incoming().viewerId == existing().viewerId &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'viewerName', 'viewerPic', 'lastViewedAt'
          ]) &&
          incoming().lastViewedAt == request.time;
      }

      allow get: if isRequesterProfileViewPath() || (
        isSignedIn() &&
        (existing().profileId == request.auth.uid || existing().viewerId == request.auth.uid)
      );
      allow list: if isSignedIn() && existing().profileId == request.auth.uid;
      allow create: if isSignedIn() && validProfileViewCreate(incoming());
      allow update: if isSignedIn() && validProfileViewUpdate();
      allow delete: if false;
    }

    match /profileClicks/{clickId} {
      function isRequesterProfileClickPath() {
        return isSignedIn() &&
          (
            clickId.matches('^[a-zA-Z0-9_\\-]+_' + request.auth.uid + '_[a-zA-Z0-9_\\-]+$') ||
            clickId.matches('^' + request.auth.uid + '_[a-zA-Z0-9_\\-]+_[a-zA-Z0-9_\\-]+$')
          );
      }

      function validProfileClickCreate(data) {
        return data.keys().hasOnly([
          'profileId', 'viewerId', 'viewerName', 'viewerPic', 'action',
          'createdAt', 'lastClickedAt'
        ]) &&
        data.profileId is string &&
        isValidId(data.profileId) &&
        data.viewerId == request.auth.uid &&
        data.profileId != request.auth.uid &&
        data.action is string &&
        data.action.size() > 0 &&
        data.action.size() <= 24 &&
        (!data.keys().hasAny(['viewerName']) || (data.viewerName is string && data.viewerName.size() <= 100)) &&
        (!data.keys().hasAny(['viewerPic']) || (data.viewerPic is string && data.viewerPic.size() <= 900000)) &&
        clickId == data.profileId + "_" + request.auth.uid + "_" + data.action &&
        data.createdAt == request.time &&
        data.lastClickedAt == request.time;
      }

      function validProfileClickUpdate() {
        return existing().viewerId == request.auth.uid &&
          incoming().profileId == existing().profileId &&
          incoming().viewerId == existing().viewerId &&
          incoming().action == existing().action &&
          incoming().diff(existing()).affectedKeys().hasOnly(['viewerName', 'viewerPic', 'lastClickedAt']) &&
          (!incoming().diff(existing()).affectedKeys().hasAny(['viewerName']) ||
            (incoming().viewerName is string && incoming().viewerName.size() <= 100)) &&
          (!incoming().diff(existing()).affectedKeys().hasAny(['viewerPic']) ||
            (incoming().viewerPic is string && incoming().viewerPic.size() <= 900000)) &&
          incoming().lastClickedAt == request.time;
      }

      allow get: if isRequesterProfileClickPath() || (
        isSignedIn() &&
        (existing().profileId == request.auth.uid || existing().viewerId == request.auth.uid)
      );
      allow list: if isSignedIn() && existing().profileId == request.auth.uid;
      allow create: if isSignedIn() && validProfileClickCreate(incoming());
      allow update: if isSignedIn() && validProfileClickUpdate();
      allow delete: if false;
    }
  }
}
